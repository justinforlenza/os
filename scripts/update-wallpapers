#!/usr/bin/env python3
"""Point wallpapers/sources.json at the newest commit of justinforlenza/wallpapers.

Run by the os-pr workflow in justinforlenza/wallpapers on every push there. Each top-level folder there is
a set; every set gets its own hash, because machines fetch only their set (a sparse checkout, see modules/options/wallpapers.nix). Needs git and nix
(without Nix on the host: NIX=scripts/nix scripts/update-wallpapers).
"""
import json
import os
import re
import shlex
import subprocess
import urllib.request
from pathlib import Path

REPO = "justinforlenza/wallpapers"
ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "wallpapers/sources.json"
NIX = shlex.split(os.environ.get("NIX", "nix"))


def run(*cmd: str, check=True) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, check=check, cwd=ROOT)


def sets_at(rev: str) -> list[str]:
    url = f"https://api.github.com/repos/{REPO}/contents?ref={rev}"
    headers = {"User-Agent": "curl/8"}
    if token := os.environ.get("GITHUB_TOKEN"):  # CI runners share IPs, so the anonymous limit runs out
        headers["Authorization"] = f"Bearer {token}"
    with urllib.request.urlopen(urllib.request.Request(url, headers=headers)) as r:
        return [e["name"] for e in json.load(r) if e["type"] == "dir"]


def hash_of(rev: str, name: str) -> str:
    # Build with a fake hash; nix reports the real one. The same call as wallpapers.nix makes.
    expr = f"""(import (builtins.getFlake (toString ./.)).inputs.nixpkgs {{ system = "x86_64-linux"; }}).fetchFromGitHub {{
      owner = "{REPO.split('/')[0]}"; repo = "{REPO.split('/')[1]}"; rev = "{rev}";
      sparseCheckout = [ "{name}" ]; hash = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="; }}"""
    r = run(*NIX, "build", "--impure", "--no-link", "--expr", expr, check=False)
    m = re.search(r"got:\s*(sha256-\S+)", r.stderr)
    if not m:
        raise SystemExit(f"no hash for {name}:\n{r.stderr}")
    return m.group(1)


def main():
    rev = run("git", "ls-remote", f"https://github.com/{REPO}", "HEAD").stdout.split()[0]
    old = json.loads(OUT.read_text()) if OUT.exists() else {}
    if old.get("rev") == rev:
        print(f"wallpapers already at {rev}")
        return
    hashes = {name: hash_of(rev, name) for name in sorted(sets_at(rev))}
    OUT.write_text(json.dumps({"rev": rev, "hashes": hashes}, indent=2) + "\n")
    print(f"wallpapers -> {rev}: {', '.join(hashes)}")


if __name__ == "__main__":
    main()
