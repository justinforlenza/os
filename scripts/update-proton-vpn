#!/usr/bin/env python3
"""Point pkgs/proton-vpn/sources.json at the newest Proton VPN app + API core in Proton's official Debian repo.

Run by update.yml. The repo index lists each .deb's SHA256, so nothing is downloaded here.
"""
import json
import re
import urllib.request
from pathlib import Path

REPO = "https://repo.protonvpn.com/debian"
WANT = {  # sources.json key: (package, index it's listed in)
    "app": ("proton-vpn-gtk-app", "binary-all"),
    "core": ("python3-proton-vpn-api-core", "binary-amd64"),  # amd64: the build with protun (Smart/Stealth)
}
OUT = Path(__file__).resolve().parent.parent / "pkgs/proton-vpn/sources.json"


def version_key(v: str):
    return [(0, int(x)) if x.isdigit() else (1, x) for x in re.split(r"[.~+-]", v)]  # (0/1, …): ints and words never compared


def newest(package: str, index: str) -> dict:
    url = f"{REPO}/dists/stable/main/{index}/Packages"
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "curl/8"})) as r:  # 403s Python's
        text = r.read().decode()
    entries = [dict(re.findall(r"^([\w-]+): (.*)$", block, re.M)) for block in text.split("\n\n")]
    matches = [e for e in entries if e.get("Package") == package]
    if not matches:
        raise SystemExit(f"{package} not found in {index}")
    e = max(matches, key=lambda e: version_key(e["Version"]))
    return {"version": e["Version"], "url": f"{REPO}/{e['Filename']}", "sha256": e["SHA256"]}


old = json.loads(OUT.read_text()) if OUT.exists() else {}
new = {key: newest(*where) for key, where in WANT.items()}
OUT.write_text(json.dumps(new, indent=2) + "\n")
for key in new:
    before = old.get(key, {}).get("version")
    print(f"Proton VPN {key}: {before} -> {new[key]['version']}" if before != new[key]["version"]
          else f"Proton VPN {key} {before} is the latest")
